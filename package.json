{
  "name": "z-search",
  "type": "module",
  "version": "1.1.0",
  "sideEffects": [
    "*.css",
    "*.css.min",
    "./src/polyfills/*.ts",
    "./src/react/utils/gcsGuard.ts"
  ],
  "description": "Academic, web, repository and vector search for Zotero — standalone search plugin",
  "config": {
    "addonName": "z-search",
    "addonID": "zsearch@z-search.dev",
    "addonRef": "zsearch",
    "addonInstance": "ZSearch",
    "prefsPrefix": "extensions.zotero.zsearch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liozhang/z-search.git"
  },
  "author": "Liozhang",
  "homepage": "https://github.com/Liozhang/z-search#readme",
  "license": "MIT",
  "scripts": {
    "postinstall": "patch-package && node scripts/build-ort-assets.cjs",
    "dev": "zotero-plugin serve",
    "build:react": "webpack --config webpack.config.js --mode=production",
    "build:react:dev": "webpack --config webpack.config.js --mode=development",
    "build": "node scripts/build-embed-frame.cjs && node scripts/build-ort-assets.cjs && npm run build:react && zotero-plugin build --dev",
    "build:prod": "node scripts/build-embed-frame.cjs && node scripts/build-ort-assets.cjs && npm run build:react && zotero-plugin build",
    "release": "zotero-plugin release",
    "rebuild": "npm run build && npm run restart",
    "restart": "node scripts/deploy.js",
    "update": "npm run build:react:dev && zotero-plugin build --dev",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "check:types": "npx tsc --noEmit && npx tsc -p tsconfig.react.json --noEmit",
    "test:zotero": "node scripts/build-ort-assets.cjs && set \"ZOTERO_PLUGIN_ZOTERO_BIN_PATH=D:/zotero10/zotero.exe\" && zotero-plugin test --exit-on-finish"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.7",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.7",
    "@ai-sdk/openai-compatible": "^3.0.40",
    "@base-ui/react": "^1.7.0",
    "@huggingface/transformers": "^4.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.14.6",
    "ai": "^7.0.77",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "jotai": "^2.19.1",
    "katex": "^0.16.9",
    "lucide-react": "^1.29.0",
    "marked": "^17.0.5",
    "marked-katex-extension": "^5.1.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "web-streams-polyfill": "^4.3.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "cssnano": "^8.0.2",
    "esbuild": "^0.25.0",
    "esbuild-loader": "^4.5.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.26",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.6.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
