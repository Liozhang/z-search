# dot files
.DS_Store
.vscode/

# Node.js
node_modules

# TSC compiled output
*.tsbuildinfo*
src/**/*.js
src/**/*.d.ts
# 例外：src/types/ 下的手写环境声明必须入库——本地缺失只影响本机，
# CI 全新检出缺了它们会整批类型报错（window/Zotero.getGlobal 等增补）
!src/types/*.d.ts

# Scaffold
.env
.scaffold
build
logs

# Coverage / test artifacts
coverage/
tests/zotero/sdt-out/

# Build output written into the source tree (webpack target)
addon/content/reactBundle.js
addon/content/reactBundle.js.map
addon/content/reactBundle.js.LICENSE.txt
addon/content/*.reactBundle.js
addon/content/*.reactBundle.js.map

# Build output written into the source tree (esbuild embed-frame)
addon/content/scripts/embed-standalone.js
addon/content/scripts/embed-standalone.js.map

# Build output copied from node_modules (scripts/build-ort-assets.cjs) —
# ORT wasm 28MB，postinstall/build/test:zotero 自动就位，不入库
addon/content/ort/

# Local audit / session artifacts
.tmp-audit/
.zcode/
